# Database
# Local development default (SQLite). For PostgreSQL (Neon/Supabase), switch provider in prisma/schema.prisma and set:
# DATABASE_URL="postgresql://user:password@host:5432/folio_books?sslmode=require"
DATABASE_URL="file:./dev.db"

# Auth.js (NextAuth v5)
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_STORE_NAME="Folio & Spine"

# Cloudinary (Image CDN)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="book_covers"

# Payment Gateway ("mock" | "razorpay" | "stripe")
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend (Transactional Emails)
RESEND_API_KEY=""
EMAIL_FROM="Folio & Spine <orders@folioandspine.example>"
